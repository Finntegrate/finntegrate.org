---
interface Props {
  term: string;
  href: string;
  summary: string;
}

const { term, href, summary } = Astro.props;
---

<a class="glossary-term" href={href} aria-label={`${term}: ${summary}`}>
  <slot>{term}</slot>
  <span class="glossary-term__summary" aria-hidden="true">{summary}</span>
</a>

<style>
  .glossary-term {
    border-bottom: 1px dashed currentColor;
    color: var(--sl-color-text-accent);
    position: relative;
    text-decoration: none;
  }

  .glossary-term:focus-visible {
    border-radius: 0.125rem;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 0.125rem;
  }

  .glossary-term__summary {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    bottom: calc(100% + 0.5rem);
    box-shadow: var(--sl-shadow-md);
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    left: 50%;
    line-height: 1.4;
    opacity: 0;
    padding: 0.5rem 0.625rem;
    pointer-events: none;
    position: absolute;
    transform: translateX(-50%);
    transition: opacity 120ms ease-in-out, visibility 120ms ease-in-out;
    visibility: hidden;
    width: max-content;
    max-width: min(20rem, calc(100vw - 2rem));
    z-index: 1;
  }

  .glossary-term:hover .glossary-term__summary,
  .glossary-term:focus-visible .glossary-term__summary {
    opacity: 1;
    visibility: visible;
  }

  @media (hover: none) {
    .glossary-term__summary {
      display: none;
    }
  }
</style>
