---
import Base from "@/layouts/Base.astro";
import CtaBanner from "@/components/CtaBanner.astro";

const agents = [
  {
    category: "Immigration & Legal Processes",
    color: "forest",
    members: [
      {
        name: "Ilmarinen",
        subtitle: "The Craftsman of Documentation",
        myth: "Named after the eternal craftsman who forged the Sampo in the Kalevala",
        desc: "Guides you through residence permits, visa processes, and official paperwork with the same precision his mythological counterpart used in forging magical artifacts.",
      },
    ],
  },
  {
    category: "Economic Integration",
    color: "amber",
    members: [
      {
        name: "Sampo",
        subtitle: "The Prosperity Guide",
        myth: "Named after the magical artifact that brought abundance",
        desc: "Helps with job searching, professional networking, and workplace culture, creating opportunities just as the mythological Sampo produced resources.",
      },
      {
        name: "Pellervo",
        subtitle: "The Harvest Guide",
        myth: "Named after the god of crops and farming",
        desc: "Specializes in entrepreneurship, business establishment, and Finnish business regulations—helping you plant seeds for future prosperity.",
      },
    ],
  },
  {
    category: "Social Services & Benefits",
    color: "nordic",
    members: [
      {
        name: "Rauni",
        subtitle: "The Prosperity Guardian",
        myth: "Named after the goddess of fertility and prosperity",
        desc: "Manages information about Kela benefits, social security, and family support, helping you access nurturing support systems in Finland.",
      },
      {
        name: "Otso",
        subtitle: "The Housing Guardian",
        myth: "Named after the respectful term for bear in Finnish",
        desc: "Specializes in housing matters, rental agreements, tenant rights, and housing benefits to help you establish and safeguard your den.",
      },
    ],
  },
  {
    category: "Education & Language",
    color: "purple",
    members: [
      {
        name: "Agricola",
        subtitle: "The Language Mentor",
        myth: "Named after Mikael Agricola, founder of written Finnish",
        desc: "Focuses on language learning resources, educational opportunities, and qualification recognition to help you access learning in Finland.",
      },
      {
        name: "Louhi",
        subtitle: "The Cultural Guide",
        myth: "Named after the powerful matriarch in the Kalevala",
        desc: "Provides cultural orientation, helping you understand Finnish customs, holidays, social norms, and everyday etiquette.",
      },
    ],
  },
  {
    category: "Health & Wellbeing",
    color: "teal",
    members: [
      {
        name: "Mielikki",
        subtitle: "The Healer",
        myth: "Named after the goddess associated with healing",
        desc: "Specializes in navigating healthcare systems, finding medical services, and understanding health insurance in Finland.",
      },
      {
        name: "Lempi",
        subtitle: "The Wellbeing Supporter",
        myth: "Named after the Finnish concept for love and affection",
        desc: "Focuses on mental health resources, wellbeing services, and community connections to support your emotional health.",
      },
    ],
  },
  {
    category: "Practical Living",
    color: "gray",
    members: [
      {
        name: "Ahti",
        subtitle: "The Navigator",
        myth: "Named after the god of waters and seas",
        desc: "Helps with transportation, utilities, banking, and everyday logistics to make daily life in Finland easier.",
      },
      {
        name: "Kokko",
        subtitle: "The Regional Expert",
        myth: "Named after the mighty eagle in Finnish mythology",
        desc: "Provides regional information, local resources, and community-specific guidance for your area in Finland.",
      },
    ],
  },
];

const steps = [
  {
    title: "Welcome & Assessment",
    desc: "Tapio welcomes you and assesses your specific needs through natural conversation.",
  },
  {
    title: "Expert Assignment",
    desc: "Based on your query, Tapio activates the specialized agent with the most relevant expertise.",
  },
  {
    title: "Specialized Assistance",
    desc: "The specialist provides detailed guidance and information in their area of expertise.",
  },
  {
    title: "Seamless Transitions",
    desc: "If needed, you'll be guided to another specialist while maintaining conversation context.",
  },
  {
    title: "Continued Support",
    desc: "Tapio remembers your situation and provides consistent support across multiple conversations.",
  },
];

const pillarClasses: Record<string, { card: string; heading: string }> = {
  forest: {
    card:    'rounded-xl p-5 border border-forest-100 bg-forest-50/40',
    heading: 'font-semibold text-forest-900 mb-1',
  },
  amber: {
    card:    'rounded-xl p-5 border border-amber-100 bg-amber-50/40',
    heading: 'font-semibold text-amber-900 mb-1',
  },
  nordic: {
    card:    'rounded-xl p-5 border border-nordic-100 bg-nordic-50/40',
    heading: 'font-semibold text-nordic-900 mb-1',
  },
};

const groupClasses: Record<string, { heading: string; card: string; subtitle: string }> = {
  forest: {
    heading:  'text-sm font-semibold uppercase tracking-widest text-forest-700 mb-4 pl-1',
    card:     'bg-white rounded-2xl p-6 border border-forest-100 hover:border-forest-300 hover:shadow-sm transition-all duration-200',
    subtitle: 'text-sm font-medium text-forest-700',
  },
  amber: {
    heading:  'text-sm font-semibold uppercase tracking-widest text-amber-700 mb-4 pl-1',
    card:     'bg-white rounded-2xl p-6 border border-amber-100 hover:border-amber-300 hover:shadow-sm transition-all duration-200',
    subtitle: 'text-sm font-medium text-amber-700',
  },
  nordic: {
    heading:  'text-sm font-semibold uppercase tracking-widest text-nordic-700 mb-4 pl-1',
    card:     'bg-white rounded-2xl p-6 border border-nordic-100 hover:border-nordic-300 hover:shadow-sm transition-all duration-200',
    subtitle: 'text-sm font-medium text-nordic-700',
  },
  purple: {
    heading:  'text-sm font-semibold uppercase tracking-widest text-purple-700 mb-4 pl-1',
    card:     'bg-white rounded-2xl p-6 border border-purple-100 hover:border-purple-300 hover:shadow-sm transition-all duration-200',
    subtitle: 'text-sm font-medium text-purple-700',
  },
  teal: {
    heading:  'text-sm font-semibold uppercase tracking-widest text-teal-700 mb-4 pl-1',
    card:     'bg-white rounded-2xl p-6 border border-teal-100 hover:border-teal-300 hover:shadow-sm transition-all duration-200',
    subtitle: 'text-sm font-medium text-teal-700',
  },
  gray: {
    heading:  'text-sm font-semibold uppercase tracking-widest text-gray-700 mb-4 pl-1',
    card:     'bg-white rounded-2xl p-6 border border-gray-100 hover:border-gray-300 hover:shadow-sm transition-all duration-200',
    subtitle: 'text-sm font-medium text-gray-700',
  },
};

const techFeatures = [
  {
    term: "Unified Knowledge Base",
    def: "A comprehensive database with specialized knowledge domains for each agent",
  },
  {
    term: "Agent Orchestration",
    def: "Intelligent routing to connect you with the most appropriate specialist for your needs",
  },
  {
    term: "Contextual Memory",
    def: "A shared system that maintains your conversation context across different specialist interactions",
  },
  {
    term: "Multilingual Support",
    def: "All agents communicate in your preferred language, making information accessible",
  },
  {
    term: "Official Source Integration",
    def: "Direct connections to information from Migri, Kela, TE Services, and other official sources",
  },
];
---

<Base
  title="Tapio — Finntegrate"
  description="Meet Tapio, the Finnish mythology-inspired AI guide through the immigration process."
>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section
    class="bg-gradient-to-br from-forest-950 via-forest-900 to-nordic-950 text-white"
  >
    <div class="max-w-4xl mx-auto px-6 py-24 text-center">
      <p
        class="text-amber-400 font-semibold uppercase tracking-widest text-sm mb-4"
      >
        Your Guide to Finland
      </p>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
        Tapio
      </h1>
      <p class="text-forest-100 text-lg leading-relaxed max-w-2xl mx-auto">
        Tapio combines Finnish cultural heritage with modern AI to create a
        meaningful support system for immigrants.
      </p>
    </div>
  </section>

  {/* ── The Forest Guide ─────────────────────────────────────────────── */}
  <section class="bg-white py-20 px-6">
    <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          Tapio: The Forest Guide
        </h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          Forests cover most of Finland's landscape and hold special meaning in
          Finnish culture and heritage.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          In Finnish mythology, Tapio is the wise and benevolent god of the
          forest who provides guidance to those who seek wisdom. Inspired by
          this tradition, our Tapio service connects you with the resources and
          information you need for your journey in Finland—just as a
          knowledgeable guide would help travelers find their way through
          Finland's vast forests.
        </p>
        <p class="text-gray-600 leading-relaxed">
          As your main guide, Tapio welcomes you, understands your needs, and
          connects you with specialized helpers for different aspects of life in
          Finland.
        </p>
      </div>

      <div class="space-y-4">
        {
          [
            {
              title: "Culturally Meaningful",
              color: "forest",
              desc: "Each agent is named after a significant figure from Finnish mythology or cultural history, creating connections to Finland's rich heritage.",
            },
            {
              title: "Specialized Expertise",
              color: "amber",
              desc: "Rather than one assistant who knows a little about everything, you get access to specialists with deep knowledge in their specific areas.",
            },
            {
              title: "Multilingual Support",
              color: "nordic",
              desc: "All agents communicate in your preferred language, making Finnish systems accessible regardless of your language background.",
            },
          ].map((item) => (
            <div
              class={pillarClasses[item.color].card}
            >
              <h3 class={pillarClasses[item.color].heading}>
                {item.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Meet Your Guides ─────────────────────────────────────────────── */}
  <section class="bg-gray-50 py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Meet Your Specialized Guides
        </h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Each agent specializes in a different aspect of life in Finland, with
          expertise drawn from their mythological counterparts.
        </p>
      </div>

      <div class="space-y-10">
        {
          agents.map((group) => (
            <div>
              <h3 class={groupClasses[group.color].heading}>
                {group.category}
              </h3>
              <div class="grid sm:grid-cols-2 gap-4">
                {group.members.map((agent) => (
                  <div class={groupClasses[group.color].card}>
                    <div class="mb-3">
                      <p class="text-lg font-bold text-gray-900">
                        {agent.name}
                      </p>
                      <p class={groupClasses[group.color].subtitle}>
                        {agent.subtitle}
                      </p>
                      <p class="text-xs text-gray-600 italic mt-1">
                        {agent.myth}
                      </p>
                    </div>
                    <p class="text-gray-600 text-sm leading-relaxed">
                      {agent.desc}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── How Tapio Works ──────────────────────────────────────────────── */}
  <section class="bg-forest-950 text-white py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">How Tapio Works</h2>
        <p class="text-forest-200 text-lg max-w-xl mx-auto">
          A coordinated system designed to provide the right expertise at the
          right time.
        </p>
      </div>

      <ol class="relative border-l border-forest-700 space-y-10 pl-8">
        {
          steps.map((step, i) => (
            <li class="relative">
              <span class="absolute -left-[2.1rem] flex items-center justify-center w-9 h-9 rounded-full bg-amber-500 text-white font-bold text-sm">
                {i + 1}
              </span>
              <h3 class="text-lg font-semibold text-white mb-1">
                {step.title}
              </h3>
              <p class="text-forest-200 leading-relaxed">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ── Behind the Scenes ────────────────────────────────────────────── */}
  <section class="bg-white py-20 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Behind the Scenes
        </h2>
        <p class="text-gray-600 text-lg max-w-xl mx-auto">
          Powered by advanced AI technology to deliver accurate, personalized
          assistance.
        </p>
      </div>

      <div
        class="bg-gray-50 rounded-2xl border border-gray-100 divide-y divide-gray-100"
      >
        {
          techFeatures.map((feat) => (
            <div class="flex items-start gap-5 px-7 py-5">
              <span class="w-2 h-2 rounded-full bg-forest-500 flex-shrink-0 mt-2" />
              <div>
                <span class="font-semibold text-gray-900">{feat.term}: </span>
                <span class="text-gray-600">{feat.def}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Agent Network Diagram ─────────────────────────────────────────── */}
  <section class="bg-gray-50 py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        The Tapio Agent Network
      </h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto mb-12">
        Explore how Tapio agents connect immigrant needs with Finnish
        organizations and services.
      </p>

      <div
        class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-0"
      >
        <div class="flex flex-col items-center">
          <div
            class="w-24 h-24 rounded-full bg-nordic-100 border-2 border-nordic-300 flex items-center justify-center mb-3"
          >
            <svg
              aria-hidden="true"
              class="w-10 h-10 text-nordic-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <p class="font-semibold text-gray-900 text-sm">Immigrant</p>
          <p class="text-xs text-gray-500 max-w-[120px] text-center mt-1">
            Needs, questions, and tasks
          </p>
        </div>

        <div
          aria-hidden="true"
          class="hidden md:block w-16 h-0.5 bg-gray-300 mx-2"
        >
        </div>
        <div aria-hidden="true" class="md:hidden w-0.5 h-8 bg-gray-300"></div>

        <div class="flex flex-col items-center">
          <div
            class="w-28 h-28 rounded-full bg-amber-100 border-2 border-amber-400 flex items-center justify-center mb-3 shadow-md"
          >
            <svg
              aria-hidden="true"
              class="w-12 h-12 text-amber-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
              ></path>
            </svg>
          </div>
          <p class="font-bold text-amber-700">Tapio Agents</p>
          <p class="text-xs text-gray-500 max-w-[140px] text-center mt-1">
            Specialized mythological guides routing to the right expertise
          </p>
        </div>

        <div
          aria-hidden="true"
          class="hidden md:block w-16 h-0.5 bg-gray-300 mx-2"
        >
        </div>
        <div aria-hidden="true" class="md:hidden w-0.5 h-8 bg-gray-300"></div>

        <div class="flex flex-col items-center">
          <div
            class="w-24 h-24 rounded-full bg-forest-100 border-2 border-forest-300 flex items-center justify-center mb-3"
          >
            <svg
              aria-hidden="true"
              class="w-10 h-10 text-forest-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <p class="font-semibold text-gray-900 text-sm">
            Finnish Organizations
          </p>
          <p class="text-xs text-gray-500 max-w-[120px] text-center mt-1">
            Migri, Kela, TE Services, municipalities
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner
    heading="Ready to Start Your Journey?"
    body="Tapio and the specialized guides are here to help you navigate every step of your move to Finland."
    primaryLabel="Learn About Our Mission"
    primaryHref="/about"
    secondaryLabel="Contact Us"
    secondaryHref="/contact"
  />
</Base>
