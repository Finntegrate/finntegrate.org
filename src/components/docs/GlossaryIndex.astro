---
import { getCollection } from 'astro:content';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';

const glossaryEntries = (await getCollection('docs'))
  .filter(
    (entry) =>
      entry.data.collection === 'shared-reference-layer' &&
      entry.data.contentType === 'reference' &&
      entry.id.startsWith('docs/glossary/') &&
      !entry.id.endsWith('/index'),
  )
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const hrefFor = (id: string) => `/${id}/`;
---

{
  glossaryEntries.length > 0 ? (
    <CardGrid>
      {glossaryEntries.map((entry) => (
        <LinkCard
          href={hrefFor(entry.id)}
          title={entry.data.title}
          description={entry.data.description}
        />
      ))}
    </CardGrid>
  ) : (
    <p>The glossary will appear here as terms are published.</p>
  )
}
