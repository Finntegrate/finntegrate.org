---
import Base from "@/layouts/Base.astro";
import WorkWithUs from "@/components/WorkWithUs.astro";
---

<Base
  title="Mission & Vision — Finntegrate"
  description="Finntegrate provides an accessible, multilingual support system that helps immigrants to Finland access the information they need and navigate administrative processes more easily."
>
  {/* ── Mission ──────────────────────────────────────────────────────── */}
  <section
    class="bg-gradient-to-br from-forest-950 via-forest-900 to-nordic-950 text-white"
  >
    <div class="max-w-4xl mx-auto px-6 py-24 text-center">
      <p
        class="text-amber-400 font-semibold uppercase tracking-widest text-sm mb-4"
      >
        Our Mission
      </p>
      <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-6">
        Accessible, multilingual support for immigrants in Finland.
      </h1>
      <p class="text-forest-100 text-lg leading-relaxed max-w-2xl mx-auto">
        We apply practical design principles to improve how immigrants interact
        with Finnish administrative systems, bridging the gap between complex
        official processes and the practical needs of people moving to a new
        country.
      </p>
    </div>
  </section>

  {/* ── Purpose ──────────────────────────────────────────────────────── */}
  <section class="bg-white py-16 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="text-gray-700 text-lg leading-relaxed">
        By providing clear guidance in multiple languages, we assist immigrants
        in completing essential tasks more efficiently, help reduce stress and
        uncertainty, and connect them with the resources they need to build
        their lives in Finland.
      </p>
    </div>
  </section>

  {/* ── How We Make a Difference ─────────────────────────────────────── */}
  <section class="bg-gray-50 py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          How We Make a Difference
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div
          class="bg-white rounded-2xl p-8 shadow-sm border border-forest-100"
        >
          <h3
            class="text-xl font-semibold text-gray-900 mb-5 flex items-center gap-3"
          >
            <span
              class="w-9 h-9 rounded-full bg-forest-100 flex items-center justify-center flex-shrink-0"
            >
              <svg
                aria-hidden="true"
                class="w-5 h-5 text-forest-700"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </span>
            For Immigrants
          </h3>
          <ul class="space-y-3 text-gray-600">
            {
              [
                "Less time spent searching for information",
                "Lower anxiety during your move to Finland",
                "More successful completion of important tasks",
                "Greater sense of control and independence",
                "Information in your preferred language",
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-forest-400 flex-shrink-0 mt-2" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-sm border border-amber-100">
          <h3
            class="text-xl font-semibold text-gray-900 mb-5 flex items-center gap-3"
          >
            <span
              class="w-9 h-9 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0"
            >
              <svg
                aria-hidden="true"
                class="w-5 h-5 text-amber-700"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                ></path>
              </svg>
            </span>
            For Service Providers
          </h3>
          <ul class="space-y-3 text-gray-600">
            {
              [
                "Fewer support requests due to confusion",
                "Better-prepared applicants with correct documents",
                "Fewer misunderstandings due to language barriers",
                "More efficient use of resources",
                "Improved service experience and satisfaction",
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-amber-400 flex-shrink-0 mt-2" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── Vision ───────────────────────────────────────────────────────── */}
  <section class="bg-forest-950 text-white py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p
          class="text-amber-400 font-semibold uppercase tracking-widest text-sm mb-3"
        >
          Our Vision
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-6">
          A Finland where integration is seamless.
        </h2>
        <p class="text-forest-100 text-lg max-w-2xl mx-auto leading-relaxed">
          We envision a Finland where language and complex processes no longer
          prevent successful integration—where immigrants can easily find and
          use the information they need to achieve their goals in their new
          home.
        </p>
      </div>

      <div
        class="bg-forest-900/50 rounded-2xl p-8 border border-forest-800 mb-10 max-w-3xl mx-auto"
      >
        <p class="text-forest-200 leading-relaxed mb-0">
          Our long-term goal is to create a trusted, comprehensive resource that
          adapts to each immigrant's unique situation, providing personalized
          guidance through every step of their integration process. By focusing
          on practical user needs rather than organizational structures, we aim
          to improve how immigrants experience Finnish administrative systems.
        </p>
      </div>

      <div class="max-w-3xl mx-auto">
        <h3 class="text-lg font-semibold text-white mb-5">
          In Our Ideal Future:
        </h3>
        <ul class="space-y-4">
          {
            [
              "Immigrants find answers to their questions in minutes rather than hours or days",
              "Information is available in all major languages spoken by Finland's immigrant communities",
              "Complex processes are broken down into clear, manageable steps with helpful guidance",
              "Public services work together to provide seamless information across different offices",
              "AI-powered assistance is available 24/7 to support immigrants whenever they need help",
            ].map((item) => (
              <li class="flex items-start gap-3 text-forest-100">
                <span aria-hidden="true" class="w-2 h-2 rounded-full bg-amber-400 flex-shrink-0 mt-1.5" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ── Core Values ──────────────────────────────────────────────────── */}
  <section class="bg-white py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Our Core Values
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        {
          [
            {
              title: "People-Centered",
              color: "forest",
              desc: 'We design our solutions based on real immigrant needs, not administrative convenience. Every decision starts with "How will this help immigrants accomplish their goals?"',
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
            },
            {
              title: "Inclusive",
              color: "nordic",
              desc: "We strive to make information accessible regardless of language, technical ability, or prior knowledge of Finnish systems. No one should be left behind.",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
            },
            {
              title: "Trustworthy",
              color: "amber",
              desc: "We prioritize accuracy, transparency, and privacy. We only provide verified information from official sources and clearly communicate the limitations of our system.",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
            },
            {
              title: "Innovative",
              color: "purple",
              desc: "We apply new technology and research to solve longstanding problems. We continuously improve our tools through testing and feedback.",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`,
            },
          ].map((value) => (
            <div
              class={`rounded-2xl p-7 border border-${value.color}-100 hover:border-${value.color}-300 hover:shadow-md transition-all duration-200`}
            >
              <div
                class={`w-11 h-11 rounded-xl bg-${value.color}-100 flex items-center justify-center mb-4`}
              >
                <svg
                  aria-hidden="true"
                  class={`w-6 h-6 text-${value.color}-700`}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  set:html={value.icon}
                />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                {value.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">{value.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Our Approach ─────────────────────────────────────────────────── */}
  <section class="bg-gray-50 py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Our Approach
        </h2>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto">
          Finntegrate combines thoughtful design with technology to address the
          unique challenges immigrants face when dealing with Finnish
          administrative systems.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100">
          <div
            class="w-11 h-11 rounded-xl bg-forest-100 flex items-center justify-center mb-4"
          >
            <svg
              aria-hidden="true"
              class="w-6 h-6 text-forest-700"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">
            Understanding User Needs
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            We study how people actually look for and use information in
            real-life situations.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            {
              [
                [
                  "Task Breakdown",
                  "Dividing complex processes into simpler, manageable steps",
                ],
                [
                  "Finding Obstacles",
                  "Identifying what gets in the way when immigrants need information",
                ],
                [
                  "Timely Information",
                  "Providing the right information when it's needed, in a useful format",
                ],
              ].map(([term, def]) => (
                <li class="flex items-start gap-2">
                  <span class="font-medium text-gray-800 flex-shrink-0">
                    {term}:
                  </span>
                  <span>{def}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100">
          <div
            class="w-11 h-11 rounded-xl bg-nordic-100 flex items-center justify-center mb-4"
          >
            <svg
              aria-hidden="true"
              class="w-6 h-6 text-nordic-700"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">
            Technology We Use
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            AI, language processing, and knowledge systems working together.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            {
              [
                [
                  "Smart Retrieval",
                  "Finding accurate information from official sources",
                ],
                [
                  "AI Helpers",
                  "Specialized tools working together to solve complex questions",
                ],
                [
                  "Multilingual Support",
                  "Breaking down language barriers so everyone can understand",
                ],
              ].map(([term, def]) => (
                <li class="flex items-start gap-2">
                  <span class="font-medium text-gray-800 flex-shrink-0">
                    {term}:
                  </span>
                  <span>{def}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100">
          <div
            class="w-11 h-11 rounded-xl bg-amber-100 flex items-center justify-center mb-4"
          >
            <svg
              aria-hidden="true"
              class="w-6 h-6 text-amber-700"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">How We Work</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">
            Practical, open, and community-driven.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            {
              [
                [
                  "Focused Development",
                  "Building working tools rather than excessive documentation",
                ],
                [
                  "Quick Testing",
                  "Small prototypes improved through real feedback",
                ],
                [
                  "Open Source",
                  "Sharing our work publicly so others can contribute",
                ],
                [
                  "Community Input",
                  "Learning from people who've experienced moving to Finland",
                ],
              ].map(([term, def]) => (
                <li class="flex items-start gap-2">
                  <span class="font-medium text-gray-800 flex-shrink-0">
                    {term}:
                  </span>
                  <span>{def}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <WorkWithUs />
</Base>
