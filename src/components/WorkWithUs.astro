---
const partners = [
  "Information Specialists",
  "Government Agencies",
  "Immigrant Support Groups",
  "Funding Organizations",
];
---

<section class="bg-forest-950 text-white py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Working Together</h2>
      <p class="text-forest-200 text-lg max-w-xl mx-auto">
        Finntegrate is built by people who've moved to Finland themselves. We
        know firsthand how challenging it can be.
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <div>
        <h3 class="text-xl font-semibold mb-4">Partner With Us</h3>
        <p class="text-forest-200 mb-6 leading-relaxed">
          We're looking for partners who want to help make Finland more
          accessible to newcomers:
        </p>
        <ul class="space-y-3">
          {
            partners.map((partner) => (
              <li class="flex items-center gap-3">
                <span
                  aria-hidden="true"
                  class="w-2 h-2 rounded-full bg-amber-400 flex-shrink-0"
                />
                <span class="text-forest-100">{partner}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="bg-forest-900/50 rounded-2xl p-8 border border-forest-800">
        <h3 class="text-xl font-semibold mb-3">Join Our Mission</h3>
        <p class="text-forest-200 mb-7 text-sm leading-relaxed">
          Help us make moving to Finland smoother for everyone. Together, we can
          create a better experience for newcomers.
        </p>
        <p
          class="text-forest-300 font-semibold mb-4 text-xs uppercase tracking-wider"
        >
          Get Involved
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="https://github.com/Finntegrate/finntegrate.org"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-white text-forest-950 font-semibold px-5 py-2.5 rounded-full hover:bg-forest-50 transition-colors text-sm"
          >
            <svg
              class="w-4 h-4 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
            GitHub Repository<span class="sr-only"> (opens in new tab)</span>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 border border-white/50 text-white font-semibold px-5 py-2.5 rounded-full hover:bg-white/10 transition-colors text-sm"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
