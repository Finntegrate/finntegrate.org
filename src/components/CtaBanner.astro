---
interface Props {
  heading: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading,
  body,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="bg-white py-16 px-6 border-t border-gray-100">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-2xl font-bold text-gray-900 mb-3">{heading}</h2>
    <p class="text-gray-600 mb-8">{body}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={primaryHref}
        class="inline-block bg-forest-900 hover:bg-forest-800 text-white font-semibold px-7 py-3 rounded-full transition-colors"
      >
        {primaryLabel}
      </a>
      {
        secondaryLabel && secondaryHref && (
          <a
            href={secondaryHref}
            class="inline-block border-2 border-forest-900 text-forest-900 hover:bg-forest-50 font-semibold px-7 py-3 rounded-full transition-colors"
          >
            {secondaryLabel}
          </a>
        )
      }
    </div>
  </div>
</section>
