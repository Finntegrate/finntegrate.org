---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Contact — Finntegrate"
  description="Get in touch with the Finntegrate team or join our public discussion community."
>

  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="bg-gradient-to-br from-forest-950 via-forest-900 to-nordic-950 text-white">
    <div class="max-w-3xl mx-auto px-6 py-24 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-4">Get in Touch</h1>
      <p class="text-forest-100 text-lg leading-relaxed max-w-xl mx-auto">
        We'd love to hear from you — whether you have a question, an idea, or want to
        collaborate.
      </p>
    </div>
  </section>

  {/* ── Primary channel ──────────────────────────────────────────────── */}
  <section class="bg-white py-20 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="bg-forest-50 border border-forest-200 rounded-2xl p-10 text-center mb-12">
        <div class="w-14 h-14 rounded-2xl bg-forest-100 flex items-center justify-center mx-auto mb-5">
          <svg aria-hidden="true" class="w-7 h-7 text-forest-700" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-forest-950 mb-3">GitHub Discussions</h2>
        <p class="text-gray-600 leading-relaxed mb-6 max-w-lg mx-auto">
          Our primary place for questions, ideas, feedback, and community conversation.
          All discussions are public — your question may help someone else too.
        </p>
        <a
          href="https://github.com/Finntegrate/finntegrate.org/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-forest-900 hover:bg-forest-800 text-white font-semibold px-7 py-3 rounded-full transition-colors"
        >
          Open a Discussion
          <span class="sr-only"> (opens in new tab)</span>
          <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      {/* ── What to discuss ──────────────────────────────────────────── */}
      <h2 class="text-xl font-bold text-gray-900 mb-5">What you can bring to the discussion</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          { title: 'Questions & Help',        desc: 'Ask anything about the project, the codebase, or Finnish immigration information.' },
          { title: 'Ideas & Feature Requests', desc: 'Share suggestions for new features, content, or improvements.' },
          { title: 'Bug Reports',             desc: 'Found something broken or inaccessible? Let us know so we can fix it.' },
          { title: 'Partnerships',            desc: 'Organizations or researchers interested in collaborating with Finntegrate.' },
        ].map(item => (
          <div class="rounded-xl border border-gray-100 bg-gray-50 p-5">
            <h3 class="font-semibold text-gray-900 mb-1">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* ── Also on GitHub ───────────────────────────────────────────────── */}
  <section class="bg-gray-50 py-16 px-6 border-t border-gray-100">
    <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center gap-6">
      <div class="flex-1">
        <h2 class="text-lg font-bold text-gray-900 mb-1">Contributing Code or Content</h2>
        <p class="text-gray-600 text-sm leading-relaxed">
          Ready to contribute directly? Read our contributing guidelines for how to run the
          project locally, branch and commit conventions, accessibility requirements, and more.
        </p>
      </div>
      <a
        href="https://github.com/Finntegrate/finntegrate.org/blob/main/CONTRIBUTING.md"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-shrink-0 inline-flex items-center gap-2 border-2 border-forest-900 text-forest-900 hover:bg-forest-50 font-semibold px-6 py-2.5 rounded-full transition-colors text-sm"
      >
        Read CONTRIBUTING.md
        <span class="sr-only"> (opens in new tab)</span>
        <svg aria-hidden="true" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

</Base>
